#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        layer_0 {
            bindings = <
&kp GRAVE  &kp N1    &kp N2    &kp N3     &kp N4     &kp N5       &kp N6     &kp N7  &kp N8     &kp N9    &kp N0    &kp BSPC
&kp TAB    &kp Q     &kp W     &kp E      &kp R      &kp T        &kp Y      &kp U   &kp I      &kp O     &kp P     &kp BSLH
&kp CAPS   &kp A     &kp S     &kp D      &kp F      &kp G        &kp H      &kp J   &kp K      &kp L     &kp SEMI  &kp SQT
&kp LSHFT  &kp Z     &kp X     &kp C      &kp V      &kp B        &kp N      &kp M   &kp COMMA  &kp DOT   &kp UP    &kp RET
&kp LCTRL  &kp LALT  &kp LGUI  &kp MINUS  &kp EQUAL  &kp SPACE    &kp SPACE  &mo 1   &kp FSLH   &kp LEFT  &kp DOWN  &kp RIGHT
            >;
        };

        layer_1 {
            bindings = <
&kp ESC                               &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_CLR    &trans    &trans  &trans    &kp F8    &kp F11  &kp F12  &trans
&trans                                &trans        &trans        &trans        &trans        &trans    &trans  &trans    &trans    &trans   &trans   &trans
&trans                                &trans        &trans        &kp LS(LPAR)  &kp LS(RPAR)  &trans    &trans  &kp LBKT  &kp RBKT  &trans   &trans   &trans
&trans                                &trans        &trans        &trans        &trans        &trans    &trans  &trans    &trans    &trans   &trans   &trans
&kp C_AC_NEXT_KEYBOARD_LAYOUT_SELECT  &trans        &trans        &trans        &trans        &trans    &trans  &trans    &trans    &trans   &trans   &trans
            >;
        };
    };
};
